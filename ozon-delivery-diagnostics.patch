+function safeDiagnosticText(text: string, accessToken: string) {
+  const secrets = [
+    accessToken, process.env.OZON_DELIVERY_CLIENT_SECRET,
+    process.env.OZON_DELIVERY_CLIENT_ID,
+    ...ozonCookies.split(/;\s*/).map((pair) => pair.slice(pair.indexOf("=") + 1)),

diff --git a/app/api/admin/ozon-delivery/approve/route.ts b/app/api/admin/ozon-delivery/approve/route.ts
new file mode 100644
index 0000000..5173229
--- /dev/null
+++ b/app/api/admin/ozon-delivery/approve/route.ts
@@ -0,0 +1,47 @@
+import { cookies } from "next/headers";
+import { NextResponse } from "next/server";
+import { getAdminCookieName, isAdminSession } from "@/lib/auth";
+import { approveOzonDeliveryForPaidOrder } from "@/lib/ozon-order";
+import { getRequestId, logAppError } from "@/lib/security";
+
+export const runtime = "nodejs";
+export const dynamic = "force-dynamic";
+
+/**
+ * Ручное подтверждение отправления к отгрузке.
+ *
+ * Нужно, когда автоматический шаг не прошёл: пополнили баланс Ozon после
+ * NotEnoughBalance или разобрались с ошибкой валидации. Роут идемпотентен —
+ * повторный вызов для уже подтверждённого заказа просто вернёт false.
+ */
+export async function POST(request: Request) {
+  const requestId = getRequestId();
+  if (request.headers.get("sec-fetch-site") === "cross-site") {
+    return NextResponse.json({ error: "Нет доступа." }, { status: 403 });
+  }
+  const cookieStore = await cookies();
+  if (!await isAdminSession(cookieStore.get(getAdminCookieName())?.value)) {
+    return NextResponse.json({ error: "Нет доступа." }, { status: 401 });
+  }
+
+  const body: unknown = await request.json().catch(() => null);
+  const rawId = body && typeof body === "object" && !Array.isArray(body)
+    ? (body as Record<string, unknown>).orderId
+    : null;
+  const orderId = typeof rawId === "string" || typeof rawId === "number" ? String(rawId).trim() : "";
+  if (!/^\d+$/.test(orderId)) {
+    return NextResponse.json({ error: "Некорректный заказ." }, { status: 400 });
+  }
+
+  try {
+    const approved = await approveOzonDeliveryForPaidOrder(orderId);
+    return NextResponse.json({ approved }, { headers: { "Cache-Control": "no-store" } });
+  } catch (cause) {
+    // Текст ошибки нужен администратору: он объясняет, что делать дальше.
+    await logAppError({ request, requestId, scope: "ozon-delivery-approve-manual", error: cause });
+    return NextResponse.json(
+      { error: cause instanceof Error ? cause.message : "Не удалось подтвердить отправление." },
+      { status: 502, headers: { "Cache-Control": "no-store" } },
+    );
+  }
+}
diff --git a/components/ozon-approve-button.tsx b/components/ozon-approve-button.tsx
new file mode 100644
index 0000000..38a1c12
--- /dev/null
+++ b/components/ozon-approve-button.tsx
@@ -0,0 +1,53 @@
+"use client";
+
+import { useState } from "react";
+import { useRouter } from "next/navigation";
+
+/**
+ * Подтверждение отправления к отгрузке из админки.
+ *
+ * Автоматический шаг уже вызывается после создания заказа, но его можно
+ * повторить вручную — например, если на балансе Ozon не хватало средств.
+ */
+export function OzonApproveButton({ orderId, status }: { orderId: string; status: string | null }) {
+  const router = useRouter();
+  const [busy, setBusy] = useState(false);
+  const [error, setError] = useState("");
+  const [done, setDone] = useState(false);
+
+  const applicable = status === "created" || status === "approve_failed" || status === "approve_expired";
+
+  if (!applicable && !done) {
+    return <span className="text-slate-500">
+      {status === "approved" ? "Подтверждён к отгрузке" : "Подтверждение недоступно"}
+    </span>;
+  }
+
+  const approve = async () => {
+    setBusy(true);
+    setError("");
+    try {
+      const response = await fetch("/api/admin/ozon-delivery/approve", {
+        method: "POST",
+        headers: { "Content-Type": "application/json" },
+        body: JSON.stringify({ orderId }),
+      });
+      const result = await response.json() as { approved?: boolean; error?: string };
+      if (!response.ok) throw new Error(result.error ?? "Не удалось подтвердить отправление.");
+      setDone(true);
+      router.refresh();
+    } catch (cause) {
+      setError(cause instanceof Error ? cause.message : "Не удалось подтвердить отправление.");
+    } finally {
+      setBusy(false);
+    }
+  };
+
+  return <div className="mt-3">
+    <button type="button" onClick={approve} disabled={busy}
+      className="rounded-lg bg-blue-700 px-3 py-1.5 text-sm font-semibold text-white disabled:opacity-50">
+      {busy ? "Подтверждаем…" : "Подтвердить к отгрузке"}
+    </button>
+    {error && <p role="alert" className="mt-2 whitespace-pre-wrap break-words text-red-700">{error}</p>}
+  </div>;
+}

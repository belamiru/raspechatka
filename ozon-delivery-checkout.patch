diff --git a/app/api/orders/[id]/ozon-delivery/points/route.ts b/app/api/orders/[id]/ozon-delivery/points/route.ts
new file mode 100644
index 0000000..4596c56
--- /dev/null
+++ b/app/api/orders/[id]/ozon-delivery/points/route.ts
@@ -0,0 +1,13 @@
+import { cookies } from "next/headers";
+import { NextResponse } from "next/server";
+import { getGuestOrder, ORDER_GUEST_COOKIE } from "@/lib/order-checkout";
+import { listOzonPickupPoints } from "@/lib/ozon-order";
+
+export const runtime = "nodejs";
+export async function GET(_: Request, context: { params: Promise<{ id: string }> }) {
+  const { id } = await context.params;
+  const order = await getGuestOrder(id, (await cookies()).get(ORDER_GUEST_COOKIE)?.value);
+  if (!order) return NextResponse.json({ error: "Заказ не найден." }, { status: 404 });
+  try { return NextResponse.json({ points: await listOzonPickupPoints() }, { headers: { "Cache-Control": "private, no-store" } }); }
+  catch { return NextResponse.json({ error: "Не удалось загрузить пункты выдачи Ozon." }, { status: 502 }); }
+}
diff --git a/app/api/orders/[id]/ozon-delivery/quote/route.ts b/app/api/orders/[id]/ozon-delivery/quote/route.ts
new file mode 100644
index 0000000..b677790
--- /dev/null
+++ b/app/api/orders/[id]/ozon-delivery/quote/route.ts
@@ -0,0 +1,21 @@
+import { cookies } from "next/headers";
+import { NextResponse } from "next/server";
+import { getGuestOrder, ORDER_GUEST_COOKIE } from "@/lib/order-checkout";
+import { getDb } from "@/lib/db";
+import { quoteOzonDelivery } from "@/lib/ozon-order";
+
+export const runtime = "nodejs";
+export async function POST(request: Request, context: { params: Promise<{ id: string }> }) {
+  if (request.headers.get("sec-fetch-site") === "cross-site") return NextResponse.json({ error: "Нет доступа." }, { status: 403 });
+  const { id } = await context.params; const token = (await cookies()).get(ORDER_GUEST_COOKIE)?.value;
+  const order = await getGuestOrder(id, token); if (!order) return NextResponse.json({ error: "Заказ не найден." }, { status: 404 });
+  const body = await request.json().catch(() => null); const pointId = body && typeof body === "object" && !Array.isArray(body) && typeof (body as Record<string, unknown>).pointId === "string" ? (body as Record<string, string>).pointId.trim() : "";
+  const phone = body && typeof body === "object" && !Array.isArray(body) && typeof (body as Record<string, unknown>).phone === "string" ? (body as Record<string, string>).phone.trim() : "";
+  if (!/^\d+$/.test(pointId) || !phone) return NextResponse.json({ error: "Выберите пункт Ozon и укажите телефон." }, { status: 400 });
+  try {
+    const row = await getDb().query<{ print_price: number; package_weight_grams: number; package_width_mm: number; package_length_mm: number; package_height_mm: number }>(`SELECT COALESCE(print_price, total_price) AS print_price, package_weight_grams, package_width_mm, package_length_mm, package_height_mm FROM orders WHERE id = $1`, [id]);
+    const pricing = row.rows[0]; if (!pricing) return NextResponse.json({ error: "Заказ не найден." }, { status: 404 });
+    const quote = await quoteOzonDelivery({ orderId: id, orderNumber: order.order_number, name: order.customer_name, phone, pointId, printPrice: Number(pricing.print_price), parcel: { weightGrams: Number(pricing.package_weight_grams), widthMm: Number(pricing.package_width_mm), lengthMm: Number(pricing.package_length_mm), heightMm: Number(pricing.package_height_mm) } });
+    return NextResponse.json(quote, { headers: { "Cache-Control": "private, no-store" } });
+  } catch (error) { return NextResponse.json({ error: error instanceof Error ? error.message : "Не удалось рассчитать доставку Ozon." }, { status: 422 }); }
+}

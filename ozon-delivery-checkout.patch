+import { randomUUID } from "node:crypto";
+import { getDb } from "@/lib/db";
+import { postOzonDeliveryApi } from "@/lib/ozon-delivery";
+import { getOzonShipmentMethod } from "@/lib/ozon-shipment-method";
+
+export type OzonPickupPoint = { id: string; name: string; address: string; type: "pvz" | "postamat" };
+type Parcel = { weightGrams: number; widthMm: number; lengthMm: number; heightMm: number };
+type Input = { orderId: string; orderNumber: string; name: string; phone: string; pointId: string; printPrice: number; parcel: Parcel };
+export type OzonQuote = { deliveryPrice: number; insurancePrice: number; deliveryDays: number | null; cutoffAt: string };
+
+function object(value: unknown): Record<string, unknown> { return value && typeof value === "object" && !Array.isArray(value) ? value as Record<string, unknown> : {}; }
+function list(value: unknown): Record<string, unknown>[] { return Array.isArray(value) ? value.map(object) : []; }
+function text(value: unknown) { return typeof value === "string" ? value.trim() : typeof value === "number" && Number.isFinite(value) ? String(value) : ""; }
+function integer(value: unknown) { const n = typeof value === "number" ? value : typeof value === "string" ? Number(value) : NaN; return Number.isFinite(n) ? n : null; }
+function money(value: unknown) { const n = integer(value); if (n === null || n < 0) throw new Error("Ozon вернул некорректную стоимость доставки."); return Math.round(n); }
+function ozonPhone(value: string) {
+  const digits = value.replace(/\D/g, "");
+  if (digits.length === 11 && (digits[0] === "7" || digits[0] === "8")) return `+7${digits.slice(1)}`;
+  if (digits.length === 10) return `+7${digits}`;
+  throw new Error("Для доставки Ozon укажите российский номер в формате +7XXXXXXXXXX.");
+}
+function parcel(value: Parcel) {
+  if (![value.weightGrams, value.widthMm, value.lengthMm, value.heightMm].every((n) => Number.isInteger(n) && n > 0)) throw new Error("Для доставки Ozon не заданы вес или габариты заказа.");
+  return { weight_g: value.weightGrams, length_mm: value.lengthMm, width_mm: value.widthMm, height_mm: value.heightMm };
+}
+async function shipmentMethodId() {
+  const method = await getOzonShipmentMethod();
+  if (!method || method.status.toLowerCase() !== "active" || !/^\d+$/.test(method.id)) throw new Error("Метод доставки Ozon не активен.");
+  return Number(method.id);
+}
+function posting(input: Input, methodId: number, cutoffAt?: string) {
+  return { request_id: Number(input.orderId), posting_external_id: input.orderNumber, shipment_method_id: methodId,
+    description: "Печатная продукция", declared_value: { amount: String(input.printPrice), currency_code: "RUB" },
+    dimensions: parcel(input.parcel), ...(cutoffAt ? { cutoff_at: cutoffAt } : {}) };
+}
+export async function listOzonPickupPoints() {
+  const unique = new Map<string, OzonPickupPoint>(); let cursor: string | undefined;
+  do {
+    const response = object(await postOzonDeliveryApi("/v1/delivery-point/list", { pagination: { limit: 100, ...(cursor ? { cursor } : {}) } }));
+    for (const point of list(response.delivery_points)) {
+      const id = text(point.delivery_point_id); const address = text(point.full_address); const type = text(point.type);
+      if (id && address && point.is_active !== false && (type === "pvz" || type === "postamat")) unique.set(id, { id, name: text(point.name) || text(point.delivery_point_number) || address, address, type });
+    }
+    cursor = text(object(response.pagination).cursor) || undefined;
+  } while (cursor);
+  return [...unique.values()];
+}
+export async function checkOzonClient(phone: string) {
+  const result = object(await postOzonDeliveryApi("/v1/delivery/check-client", { phone_number: ozonPhone(phone) }));
+  return result.can_be_delivered === true;
+}
+export async function quoteOzonDelivery(input: Input): Promise<OzonQuote> {
+  const methodId = await shipmentMethodId();
+  if (!await checkOzonClient(input.phone)) throw new Error("Доставка Ozon доступна только покупателям с зарегистрированным аккаунтом Ozon.");
+  const availability = object(await postOzonDeliveryApi("/v1/delivery-point/check-availability", {
+    delivery_point_ids: [Number(input.pointId)], shipment_method_id: methodId,
+    postings: [{ request_id: Number(input.orderId), declared_value: { amount: String(input.printPrice), currency_code: "RUB" }, dimensions: parcel(input.parcel) }],
+  }));
+  const unavailable = list(availability.results).find((item) => item.is_available === false || item.can_be_delivered === false);
+  if (unavailable) throw new Error("Выбранный пункт Ozon недоступен для этого заказа.");
+  const response = object(await postOzonDeliveryApi("/v1/order/checkout", {
+    recipient: { phone_number: ozonPhone(input.phone) }, postings: [posting(input, methodId)], delivery: { delivery_point: { delivery_point_id: Number(input.pointId) } },
+  }));
+  const result = list(response.results)[0]; const calculated = object(result.posting);
+  const cutoffAt = text(calculated.cutoff_at);
+  if (!result || !cutoffAt) throw new Error("Ozon не подтвердил условия доставки для выбранного пункта.");
+  return { deliveryPrice: money(object(calculated.estimated_delivery_cost).amount), insurancePrice: money(object(calculated.estimated_insurance_cost).amount), deliveryDays: integer(calculated.estimated_delivery_days), cutoffAt };
+}
+export async function createOzonDeliveryForPaidOrder(orderId: string) {
+  const db = getDb();
+  const claimed = await db.query<{ id: string; order_number: string; customer_name: string; customer_phone: string; pickup_point_id: string; print_price: number; delivery_price: number; package_weight_grams: number; package_width_mm: number; package_length_mm: number; package_height_mm: number; ozon_delivery_idempotency_key: string | null }>(`
+    UPDATE orders SET ozon_delivery_status = 'creating', ozon_delivery_error = NULL, updated_at = NOW()
+    WHERE id = $1 AND fulfillment_method = 'ozon_pickup_point' AND ozon_order_number IS NULL AND COALESCE(ozon_delivery_status, '') <> 'creating'
+    RETURNING id, order_number, customer_name, customer_phone, pickup_point_id, print_price, delivery_price, package_weight_grams, package_width_mm, package_length_mm, package_height_mm, ozon_delivery_idempotency_key`, [orderId]);
+  const order = claimed.rows[0]; if (!order) return false;
+  try {
+    const input: Input = { orderId: order.id, orderNumber: order.order_number, name: order.customer_name, phone: order.customer_phone, pointId: order.pickup_point_id, printPrice: Number(order.print_price), parcel: { weightGrams: Number(order.package_weight_grams), widthMm: Number(order.package_width_mm), lengthMm: Number(order.package_length_mm), heightMm: Number(order.package_height_mm) } };
+    const quote = await quoteOzonDelivery(input);
+    if (quote.deliveryPrice + quote.insurancePrice !== Number(order.delivery_price)) throw new Error("Условия Ozon изменились после оплаты: заказ не создан автоматически.");
+    const methodId = await shipmentMethodId(); const key = order.ozon_delivery_idempotency_key || randomUUID();
+    const response = object(await postOzonDeliveryApi("/v1/order/create", { order_external_id: order.order_number, recipient: { phone_number: ozonPhone(order.customer_phone), full_name: order.customer_name }, postings: [posting(input, methodId, quote.cutoffAt)], delivery: { delivery_point: { delivery_point_id: Number(order.pickup_point_id) } } }, { "Idempotency-Key": key }));
+    const orderNumber = text(response.order_number);
+    if (!orderNumber) throw new Error("Ozon не вернул номер созданного заказа.");
+    await db.query(`UPDATE orders SET ozon_delivery_idempotency_key = $1, ozon_order_number = $2, ozon_delivery_status = 'created', ozon_delivery_error = NULL, ozon_delivery_created_at = NOW(), updated_at = NOW() WHERE id = $3`, [key, orderNumber, order.id]);
+    return true;
+  } catch (error) { const message = error instanceof Error ? error.message.slice(0, 2000) : "Не удалось создать заказ Ozon."; await db.query(`UPDATE orders SET ozon_delivery_status = 'failed', ozon_delivery_error = $1, updated_at = NOW() WHERE id = $2`, [message, order.id]); throw error; }
+}
